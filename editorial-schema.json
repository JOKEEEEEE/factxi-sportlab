    {"position": 2, "role": "contrast", "fields": ["kicker", "stat", "explanation"]},
    {"position": 3, "role": "setup", "fields": ["kicker", "score_and_minute", "explanation"]},
    {"position": 4, "role": "turning_point", "fields": ["kicker", "stat", "explanation"]},
    {"position": 5, "role": "consequence", "fields": ["kicker", "stat", "explanation"]},
    {"position": 6, "role": "conclusion", "fields": ["kicker", "headline", "explanation", "source"]}
  ],
  "pipeline": ["api_football_raw", "normalized_match", "deterministic_calculations", "llm_editorial_copy", "validation", "image_render"]
}
